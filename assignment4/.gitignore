# --------------------
# 1. Python 가상 환경 및 캐시
# --------------------
# Virtual environment (가상 환경 폴더)
venv/
.venv/
ENV/
env/

# Byte-code files (파이썬이 자동으로 생성하는 캐시)
__pycache__/
*.pyc

# --------------------
# 2. 보안 및 민감 정보
# --------------------
# Environment variables (API 키와 같은 민감 정보가 담긴 파일)
.env

# --------------------
# 3. IDE 및 OS 파일
# --------------------
# VS Code files
.vscode/*

# Jupyter/IPython Notebook files
.ipynb_checkpoints

# OS generated files
.DS_Store